meta {
  name: Hent alle tilgængelige rute-statusser
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/RouteStatus
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech/
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/RouteStatus
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "name": ""
          }
        ]
      '''
    }
  }
}

