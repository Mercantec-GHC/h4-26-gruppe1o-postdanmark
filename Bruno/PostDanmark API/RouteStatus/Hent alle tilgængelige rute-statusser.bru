meta {
  name: Hent alle tilgængelige rute-statusser
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/RouteStatus
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response er en liste", function() {
    const d = res.getBody();
    expect(d).to.be.an("array");
  });
  test("Første element indeholder name", function() {
    const d = res.getBody();
    expect(d[0]).to.have.property("name");
  });
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/RouteStatus
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "name": ""
          }
        ]
      '''
    }
  }
}

