meta {
  name: Opdater status for en specifik leveringsrute. Brug seeded værdier: 1 = Pending, 2 = Assigned, 3 = Active, 4 = Completed, 5 = Cancelled
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/RouteStatus/route/:routeId
  body: json
  auth: inherit
}

params:path {
  routeId: {{createdRouteId}}
}

body:json {
  {
    "routeStatusId": 2
  }
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder id og routeStatusId", function() {
    const d = res.getBody();
    expect(d).to.have.property("id");
    expect(d).to.have.property("routeStatusId");
  });
  test("Response indeholder stops", function() {
    const d = res.getBody();
    expect(d).to.have.property("stops");
    expect(d.stops).to.be.an("array");
  });
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/RouteStatus/route/:routeId
    method: PUT
    mode: json
    params:path: {
      routeId: 
    }
  
    body:json: {
      {
        "routeStatusId": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "scheduledDate": "",
          "totalDistanceKm": 0,
          "estimatedDurationMinutes": 0,
          "userId": 0,
          "assignedUserId": 0,
          "assignedUserName": "",
          "routeStatusId": 0,
          "statusName": "",
          "stops": [
            {
              "address": "",
              "latitude": 0,
              "longitude": 0,
              "sequence": 0,
              "status": {
                "name": ""
              }
            }
          ]
        }
      '''
    }
  }
}

