meta {
  name: Hent den aktuelle status for en specifik leveringsrute
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/RouteStatus/route/:routeId
  body: none
  auth: inherit
}

params:path {
  routeId: {{createdRouteId}}
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder name", function() {
    const d = res.getBody();
    expect(d).to.have.property("name");
  });
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/RouteStatus/route/:routeId
    method: GET
    mode: none
    params:path: {
      routeId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "name": ""
        }
      '''
    }
  }
}

