meta {
  name: Henter alle brugere med tilhørende roller og ruter. Kun Admin-brugere har adgang.
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/User
  body: none
  auth: inherit
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response er en liste af brugere", function() {
    const d = res.getBody();
    expect(d).to.be.an("array");
    expect(d[0]).to.have.property("id");
    expect(d[0]).to.have.property("email");
    expect(d[0]).to.have.property("role");
  });
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}
