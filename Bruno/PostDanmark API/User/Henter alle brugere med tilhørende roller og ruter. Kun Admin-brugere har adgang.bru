meta {
  name: Henter alle brugere med tilhørende roller og ruter. Kun Admin-brugere har adgang.
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/User
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech/
}

example {
  name: 200 Response
  description: OK – Returnerer en liste af brugere med detaljer.
  
  request: {
    url: {{baseUrl}}/api/User
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "id": 0,
            "name": "",
            "email": "",
            "createdAt": "",
            "role": {
              "name": ""
            },
            "deliveryRoutes": [
              {
                "id": 0,
                "name": "",
                "scheduledDate": "",
                "totalDistanceKm": 0,
                "estimatedDurationMinutes": 0,
                "userId": 0,
                "assignedUserId": 0,
                "assignedUserName": "",
                "routeStatusId": 0,
                "statusName": "",
                "stops": [
                  {
                    "address": "",
                    "latitude": 0,
                    "longitude": 0,
                    "sequence": 0,
                    "status": {
                      "name": ""
                    }
                  }
                ]
              }
            ]
          }
        ]
      '''
    }
  }
}

