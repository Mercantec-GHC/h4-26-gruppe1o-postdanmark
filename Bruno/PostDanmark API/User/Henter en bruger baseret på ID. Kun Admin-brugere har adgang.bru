meta {
  name: Henter en bruger baseret på ID. Kun Admin-brugere har adgang.
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/User/:id
  body: none
  auth: inherit
}

params:path {
  id: 
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech/
}

example {
  name: 200 Response
  description: OK – Returnerer brugerens detaljer.
  
  request: {
    url: {{baseUrl}}/api/User/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "email": "",
          "createdAt": "",
          "role": {
            "name": ""
          },
          "deliveryRoutes": [
            {
              "id": 0,
              "name": "",
              "scheduledDate": "",
              "totalDistanceKm": 0,
              "estimatedDurationMinutes": 0,
              "userId": 0,
              "assignedUserId": 0,
              "assignedUserName": "",
              "routeStatusId": 0,
              "statusName": "",
              "stops": [
                {
                  "address": "",
                  "latitude": 0,
                  "longitude": 0,
                  "sequence": 0,
                  "status": {
                    "name": ""
                  }
                }
              ]
            }
          ]
        }
      '''
    }
  }
}

