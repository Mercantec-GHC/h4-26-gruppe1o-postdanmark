meta {
  name: Henter en bruger baseret på ID. Kun Admin-brugere har adgang.
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/User/:id
  body: none
  auth: inherit
}

params:path {
  id: {{createdUserId}}
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder bruger detaljer", function() {
    const d = res.getBody();
    expect(d).to.have.property("id");
    expect(d).to.have.property("email");
    expect(d).to.have.property("role");
  });
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}
