meta {
  name: Hent vejgeometri mellem en række koordinater (hurtigste kørerute, uden færger når muligt).
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Routing/road-geometry
  body: json
  auth: inherit
}

body:json {
  {
    "coordinates": [
      {
        "latitude": 56.4532,
        "longitude": 9.4023
      },
      {
        "latitude": 56.4602,
        "longitude": 9.4150
      }
    ]
  }
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder coordinates", function() {
    const d = res.getBody();
    expect(d).to.have.property("coordinates");
    expect(d.coordinates).to.be.an("array");
  });
  test("Coordinates indeholder latitude og longitude", function() {
    const d = res.getBody();
    expect(d.coordinates[0]).to.have.property("latitude");
    expect(d.coordinates[0]).to.have.property("longitude");
  });
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/Routing/road-geometry
    method: POST
    mode: json
    body:json: {
      {
        "coordinates": [
          {
            "latitude": 0,
            "longitude": 0
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "coordinates": [
            {
              "latitude": 0,
              "longitude": 0
            }
          ]
        }
      '''
    }
  }
}

