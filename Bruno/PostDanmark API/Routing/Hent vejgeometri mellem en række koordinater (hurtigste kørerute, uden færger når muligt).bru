meta {
  name: Hent vejgeometri mellem en række koordinater (hurtigste kørerute, uden færger når muligt).
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Routing/road-geometry
  body: json
  auth: inherit
}

body:json {
  {
    "coordinates": [
      {
        "latitude": 0,
        "longitude": 0
      }
    ]
  }
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech/
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/Routing/road-geometry
    method: POST
    mode: json
    body:json: {
      {
        "coordinates": [
          {
            "latitude": 0,
            "longitude": 0
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "coordinates": [
            {
              "latitude": 0,
              "longitude": 0
            }
          ]
        }
      '''
    }
  }
}

