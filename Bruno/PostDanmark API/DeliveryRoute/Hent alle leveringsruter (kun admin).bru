meta {
  name: Hent alle leveringsruter (kun admin)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/DeliveryRoute
  body: none
  auth: inherit
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response er en liste", function() {
    const d = res.getBody();
    expect(d).to.be.an("array");
  });
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}
