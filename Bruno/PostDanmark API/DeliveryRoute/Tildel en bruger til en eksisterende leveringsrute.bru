meta {
  name: Tildel en bruger til en eksisterende leveringsrute
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/DeliveryRoute/:id/assign
  body: json
  auth: inherit
}

params:path {
  id: {{createdRouteId}}
}

body:json {
  {{createdUserId}}
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder id og assignedUserId", function() {
    const d = res.getBody();
    expect(d).to.have.property("id");
    expect(d).to.have.property("assignedUserId");
  });
  test("Response indeholder stops", function() {
    const d = res.getBody();
    expect(d).to.have.property("stops");
    expect(d.stops).to.be.an("array");
  });
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/DeliveryRoute/:id/assign
    method: PUT
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "scheduledDate": "",
          "totalDistanceKm": 0,
          "estimatedDurationMinutes": 0,
          "userId": 0,
          "assignedUserId": 0,
          "assignedUserName": "",
          "routeStatusId": 0,
          "statusName": "",
          "stops": [
            {
              "address": "",
              "latitude": 0,
              "longitude": 0,
              "sequence": 0,
              "status": {
                "name": ""
              }
            }
          ]
        }
      '''
    }
  }
}

