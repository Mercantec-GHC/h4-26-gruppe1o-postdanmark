meta {
  name: Opret en ny leveringsrute med stoppesteder. Adresser bliver automatisk geokodet til koordinater.
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/DeliveryRoute
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{routeName}}",
    "scheduledDate": "{{scheduledDate}}",
    "userId": {{createdUserId}},
    "stops": [
      { "address": "Slagelsevej 10, 4200 Slagelse" },
      { "address": "Vestergade 5, 5000 Odense" },
      { "address": "Nørregade 2, 8000 Aarhus" }
    ]
  }
}

script:pre-request {
  const ts = Date.now();
  bru.setVar("routeName", `TestRute_${ts}`);
  bru.setVar("scheduledDate", new Date().toISOString().split("T")[0]);
}

script:post-response {
  if (res.status === 201) {
    // Response body er tom - hent route id fra Location header
    const loc = res.headers["location"] || "";
    const match = loc.match(/\/(\d+)$/);
    if (match) bru.setEnvVar("createdRouteId", match[1]);

    // createdStopId sættes i "Hent en leveringsrute via ID" (seq 3)
  }
}

tests {
  test("Status er 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Location header indeholder route id", function() {
    const loc = res.headers["location"] || "";
    expect(loc).to.match(/\/\d+$/);
  });
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}
