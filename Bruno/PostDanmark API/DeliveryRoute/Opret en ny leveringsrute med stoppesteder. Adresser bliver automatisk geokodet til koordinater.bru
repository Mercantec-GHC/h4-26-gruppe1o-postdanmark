meta {
  name: Opret en ny leveringsrute med stoppesteder. Adresser bliver automatisk geokodet til koordinater.
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/DeliveryRoute
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{routeName}}",
    "scheduledDate": "{{scheduledDate}}",
    "userId": {{createdUserId}},
    "stops": [
      { "address": "Slagelsevej 10, 4200 Slagelse" },
      { "address": "Vestergade 5, 5000 Odense" },
      { "address": "Nørregade 2, 8000 Aarhus" }
    ]
  }
}

script:pre-request {
  const ts = Date.now();
  bru.setVar("routeName", `TestRute_${ts}`);
  bru.setVar("scheduledDate", new Date().toISOString().split("T")[0]);
}

script:post-response {
  if (res.status === 201) {
    const d = typeof res.body === "string" ? JSON.parse(res.body) : (res.body || {});
    if (d?.id != null) bru.setEnvVar("createdRouteId", String(d.id));
    if (d?.stops?.length > 0 && d.stops[0].id != null) bru.setEnvVar("createdStopId", String(d.stops[0].id));
  }
}

tests {
  test("Status er 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Response indeholder id og stops", function() {
    const d = res.getBody();
    expect(d).to.have.property("id");
    expect(d).to.have.property("stops");
    expect(d.stops).to.be.an("array").that.is.not.empty;
  });
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}
