meta {
  name: Hent alle leveringsruter for en bruger
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/DeliveryRoute/user/:userId
  body: none
  auth: inherit
}

params:path {
  userId: {{createdUserId}}
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response er en liste", function() {
    const d = res.getBody();
    expect(d).to.be.an("array");
  });
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}
