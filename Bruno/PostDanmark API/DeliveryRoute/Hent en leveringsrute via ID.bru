meta {
  name: Hent en leveringsrute via ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/DeliveryRoute/:id
  body: none
  auth: inherit
}

params:path {
  id: {{createdRouteId}}
}

script:post-response {
  if (res.status === 200) {
    const body = res.getBody();
    if (body && body.stops && body.stops.length > 0 && body.stops[0].id != null) {
      bru.setEnvVar("createdStopId", String(body.stops[0].id));
    }
  }
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder id og stops", function() {
    const d = res.getBody();
    expect(d).to.have.property("id");
    expect(d).to.have.property("stops");
  });
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}
