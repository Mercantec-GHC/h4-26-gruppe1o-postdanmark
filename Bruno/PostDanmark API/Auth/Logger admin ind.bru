meta {
  name: Logger admin ind.
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/Auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const d = typeof res.body === "string" ? JSON.parse(res.body) : (res.body || {});
    const token = d?.token ?? d?.Token;
    if (token) bru.setEnvVar("token", String(token));
  }
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder token", function() {
    const d = res.getBody();
    expect(d).to.have.property("token");
  });
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}
