meta {
  name: Logger en bruger ind.
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/Auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "",
    "password": ""
  }
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech/
}

example {
  name: 200 Response
  description: OK – Login succesfuldt. Returnerer JWT token og brugerinfo.
  
  request: {
    url: {{baseUrl}}/api/Auth/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 400 Response
  description: Bad Request – Manglende eller ugyldige loginoplysninger.
  
  request: {
    url: {{baseUrl}}/api/Auth/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "detail": "",
          "instance": ""
        }
      '''
    }
  }
}

