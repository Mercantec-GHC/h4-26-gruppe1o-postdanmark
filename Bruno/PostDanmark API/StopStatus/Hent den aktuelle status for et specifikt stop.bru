meta {
  name: Hent den aktuelle status for et specifikt stop
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/StopStatus/stop/:stopId
  body: none
  auth: inherit
}

params:path {
  stopId: {{createdStopId}}
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder address og status", function() {
    const d = res.getBody();
    expect(d).to.have.property("address");
    expect(d).to.have.property("status");
  });
  test("Response indeholder latitude og longitude", function() {
    const d = res.getBody();
    expect(d).to.have.property("latitude");
    expect(d).to.have.property("longitude");
  });
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/StopStatus/stop/:stopId
    method: GET
    mode: none
    params:path: {
      stopId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "address": "",
          "latitude": 0,
          "longitude": 0,
          "sequence": 0,
          "status": {
            "name": ""
          }
        }
      '''
    }
  }
}

