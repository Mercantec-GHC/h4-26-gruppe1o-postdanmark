meta {
  name: Opdater status for et specifikt stop. Sæt StopId til de seeded værdier i databasen: 1 = Scheduled, 2 = Delivered, 3 = Failed
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/StopStatus/stop/:stopId
  body: json
  auth: inherit
}

params:path {
  stopId: {{createdStopId}}
}

body:json {
  {
    "stopStatusId": 2
  }
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder address og status", function() {
    const d = res.getBody();
    expect(d).to.have.property("address");
    expect(d).to.have.property("status");
  });
  test("Status indeholder name", function() {
    const d = res.getBody();
    expect(d.status).to.have.property("name");
  });
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/StopStatus/stop/:stopId
    method: PUT
    mode: json
    params:path: {
      stopId: 
    }
  
    body:json: {
      {
        "stopStatusId": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "address": "",
          "latitude": 0,
          "longitude": 0,
          "sequence": 0,
          "status": {
            "name": ""
          }
        }
      '''
    }
  }
}

