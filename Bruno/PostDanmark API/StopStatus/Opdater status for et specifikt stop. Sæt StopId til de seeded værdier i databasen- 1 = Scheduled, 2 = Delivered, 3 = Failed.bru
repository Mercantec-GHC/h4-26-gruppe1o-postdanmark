meta {
  name: Opdater status for et specifikt stop. Sæt StopId til de seeded værdier i databasen: 1 = Scheduled, 2 = Delivered, 3 = Failed
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/StopStatus/stop/:stopId
  body: json
  auth: inherit
}

params:path {
  stopId: 
}

body:json {
  {
    "stopStatusId": 0
  }
}

vars:pre-request {
  baseUrl: https://postdanmark-api.mercantec.tech/
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/StopStatus/stop/:stopId
    method: PUT
    mode: json
    params:path: {
      stopId: 
    }
  
    body:json: {
      {
        "stopStatusId": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "address": "",
          "latitude": 0,
          "longitude": 0,
          "sequence": 0,
          "status": {
            "name": ""
          }
        }
      '''
    }
  }
}

